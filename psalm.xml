<?xml version="1.0"?>
<!--
    Standalone Psalm configuration. The other CORS bundles include vendor/cors/dev/psalm.xml, but
    cors/dev is a private package: this repository is public and its CI has no access to the
    private Packagist, so the shared base cannot be a dependency here.
-->
<psalm
    errorLevel="7"
    resolveFromConfigFile="true"
    findUnusedCode="false"
    findUnusedBaselineEntry="false"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
>
    <projectFiles>
        <directory name="src/DataDefinitionsBundle" />
        <ignoreFiles>
            <directory name="vendor" />
            <!-- Optional integrations: only loaded when the third-party package is installed -->
            <directory name="src/DataDefinitionsBundle/CoreShop" />
            <!-- Doctrine migrations are generated code -->
            <directory name="src/DataDefinitionsBundle/Migrations" />
        </ignoreFiles>
    </projectFiles>

    <issueHandlers>
        <UndefinedConstant>
            <errorLevel type="suppress">
                <!-- PIMCORE_* constants are defined at runtime by Pimcore\Bootstrap -->
                <directory name="src/DataDefinitionsBundle" />
            </errorLevel>
        </UndefinedConstant>
        <UndefinedMagicMethod errorLevel="info" />
        <UndefinedDocblockClass errorLevel="info" />
        <DeprecatedClass errorLevel="info" />
        <DeprecatedMethod errorLevel="info" />
        <DeprecatedInterface errorLevel="info" />
        <DeprecatedTrait errorLevel="info" />
        <InternalMethod errorLevel="info" />
        <InternalClass errorLevel="info" />
        <MethodSignatureMismatch errorLevel="info" />
        <InvalidCatch errorLevel="info" />
    </issueHandlers>
</psalm>
